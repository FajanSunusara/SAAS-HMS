<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"  stylesheets="@/css/sidebar.css,@/css/invoices.css" fx:controller="application.controllers.InvoiceController">
 
      <!-- Sidebar Integration -->
   <left>
<fx:include source="/fxml1/Sidebar.fxml"/>
</left>
   
    <center>
        <VBox styleClass="invoice-main-panel">
            <padding>
                <Insets topRightBottomLeft="15.0" />
            </padding>
            <spacing>15.0</spacing>
            
            <!-- Header with Title -->
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label text="Invoice Management" styleClass="page-title" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="filteredResultsLabel" text="0 invoices" styleClass="results-count" />
            </HBox>
            
            <!-- Filter Bar (GridPane for 2x2 layout) -->
            <GridPane hgap="8.0" vgap="8.0" alignment="CENTER_LEFT" styleClass="filter-grid">
                <padding>
                    <Insets topRightBottomLeft="12.0" />
                </padding>
                <columnConstraints>
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="150.0" />
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="150.0" />
                </columnConstraints>
                <Label text="Date From:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                <DatePicker fx:id="dateFromPicker" GridPane.rowIndex="0" GridPane.columnIndex="1" maxWidth="Infinity" />
                <Label text="Date To:" GridPane.rowIndex="0" GridPane.columnIndex="2" />
                <DatePicker fx:id="dateToPicker" GridPane.rowIndex="0" GridPane.columnIndex="3" maxWidth="Infinity" />
                <Label text="Payment Type:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                <ComboBox fx:id="paymentTypeComboBox" promptText="Select Type" GridPane.rowIndex="1" GridPane.columnIndex="1" maxWidth="Infinity" />
                <Label text="Status:" GridPane.rowIndex="1" GridPane.columnIndex="2" />
                <ComboBox fx:id="statusComboBox" promptText="Select Status" GridPane.rowIndex="1" GridPane.columnIndex="3" maxWidth="Infinity" />
                <!-- Clear Filters Button -->
                <HBox alignment="CENTER_RIGHT" spacing="8" GridPane.rowIndex="2" GridPane.columnIndex="0" GridPane.columnSpan="4">
                    <Button fx:id="saveFilterButton" text="Save Filter" onAction="#handleSaveFilter" styleClass="accent-button" />
                    <Button fx:id="clearFiltersButton" text="Clear Filters" onAction="#handleClearFilters" styleClass="secondary-button" />
                </HBox>
            </GridPane>
            
            <!-- Summary Grid -->
            <GridPane hgap="15.0" vgap="8.0" alignment="CENTER_LEFT" styleClass="summary-grid">
                <padding>
                    <Insets topRightBottomLeft="12.0" />
                </padding>
                <columnConstraints>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                </columnConstraints>
                <Label text="Total Revenue:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="summary-label" />
                <Label fx:id="totalRevenueLabel" text="₹0.00" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="summary-value" />
                <Label text="Total Taxes:" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="summary-label" />
                <Label fx:id="totalTaxesLabel" text="₹0.00" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="summary-value" />
                <Label text="Net Profit:" GridPane.rowIndex="0" GridPane.columnIndex="2" styleClass="summary-label" />
                <Label fx:id="netProfitLabel" text="₹0.00" GridPane.rowIndex="1" GridPane.columnIndex="2" styleClass="summary-value" />
                <Label text="Default Tax %:" GridPane.rowIndex="0" GridPane.columnIndex="3" styleClass="summary-label" />
                <TextField fx:id="taxPercentageField" promptText="e.g., 18" text="18.0" prefWidth="70.0" GridPane.rowIndex="1" GridPane.columnIndex="3" styleClass="tax-field-in-summary"/>
            </GridPane>
            
            <!-- Invoice TableView -->
            <TableView fx:id="invoiceTable" VBox.vgrow="ALWAYS" styleClass="invoice-table">
                <columns>
                    <TableColumn fx:id="selectColumn" text="Select" prefWidth="40.0" minWidth="40.0" />
                    <TableColumn fx:id="invoiceIdColumn" text="ID" prefWidth="120.0" minWidth="100.0" />
                    <TableColumn fx:id="customerNameColumn" text="Customer Name" prefWidth="140.0" minWidth="120.0" />
                    <TableColumn fx:id="dateColumn" text="Date" prefWidth="100.0" minWidth="90.0" />
                    <TableColumn fx:id="amountColumn" text="Amount" prefWidth="90.0" minWidth="80.0" />
                    <TableColumn fx:id="taxPercentageColumn" text="Tax %" prefWidth="60.0" minWidth="50.0" />
                    <TableColumn fx:id="totalColumn" text="Total" prefWidth="90.0" minWidth="80.0" />
                    <TableColumn fx:id="statusColumn" text="Status" prefWidth="80.0" minWidth="70.0" />
                    <TableColumn fx:id="actionColumn" text="Action" prefWidth="80.0" minWidth="70.0" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
            
            <!-- Action Buttons -->
            <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="action-buttons">
                <Button fx:id="exportSelectedExcelButton" text="Export Selected (Excel)" onAction="#handleExportSelectedExcel" styleClass="primary-button" />
                <Button fx:id="exportSelectedPdfButton" text="Export Selected (PDF)" onAction="#handleExportSelectedPdf" styleClass="primary-button" />
                <Button fx:id="exportFilteredExcelButton" text="Export Filtered (Excel)" onAction="#handleExportFilteredExcel" styleClass="accent-button" />
                <Button fx:id="exportFilteredPdfButton" text="Export Filtered (PDF)" onAction="#handleExportFilteredPdf" styleClass="accent-button" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="saveFilteredToDbButton" text="Save Filtered to DB" onAction="#handleSaveFilteredToDb" styleClass="secondary-button" />
                <Button fx:id="addInvoiceButton" text="Add Invoice" onAction="#handleAddInvoice" styleClass="accent-button" />
            </HBox>
        </VBox>
    </center>
</BorderPane>
