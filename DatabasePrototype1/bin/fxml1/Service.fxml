<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>

<BorderPane fx:controller="application.controllers.ServiceController"
            xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            minWidth="1000" minHeight="700" prefWidth="Infinity" prefHeight="Infinity" stylesheets="@/css/service.css, @/css/sidebar.css"
            styleClass="main-background">

     <!-- Sidebar Integration -->
   <left>
<fx:include source="/fxml1/Sidebar.fxml"/>
</left>

    <center>
        <VBox spacing="20" maxWidth="Infinity" maxHeight="Infinity">
            <BorderPane.margin>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </BorderPane.margin>

            <HBox spacing="20" VBox.vgrow="SOMETIMES" maxWidth="Infinity">
                <VBox spacing="10" styleClass="card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>
                    <GridPane hgap="10" vgap="5">
                        <Label text="Guest Information" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="section-title"/>
                        <Label text="Booking ID:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="info-label"/>
                        <TextField fx:id="txtBookingId" editable="false" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="info-text-field"
                                   maxWidth="Infinity" GridPane.hgrow="ALWAYS"/>
                        <Label text="Room No:" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="info-label"/>
                        <TextField fx:id="txtRoomNo" editable="false" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="info-text-field"
                                   maxWidth="Infinity" GridPane.hgrow="ALWAYS"/>
                        <Label text="Guest Name:" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="info-label"/>
                        <TextField fx:id="txtGuestName" editable="false" GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="info-text-field"
                                   maxWidth="Infinity" GridPane.hgrow="ALWAYS"/>
                    </GridPane>
                </VBox>

                <VBox spacing="10" styleClass="card" HBox.hgrow="SOMETIMES" maxWidth="Infinity" minWidth="200">
                    <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
                    <Label text="Available Services" styleClass="section-title"/>
                    <ListView fx:id="listServices" prefHeight="120" maxWidth="Infinity" VBox.vgrow="ALWAYS"/>
                </VBox>
            </HBox>

            <VBox spacing="15" styleClass="card" VBox.vgrow="ALWAYS" maxWidth="Infinity" maxHeight="Infinity">
                <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
                <Label text="Service Taken List" styleClass="section-title"/>
                <TableView fx:id="tableServices" VBox.vgrow="ALWAYS" editable="true" maxWidth="Infinity" maxHeight="Infinity">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colDate" text="Date" prefWidth="100"/>
                        <TableColumn fx:id="colName" text="Service" prefWidth="120" editable="true"/>
                        <TableColumn fx:id="colType" text="Category" prefWidth="90" editable="true"/>
                        <TableColumn fx:id="colQuantity" text="Total Qty" prefWidth="70"/>
                        <TableColumn fx:id="colAmount" text="Total Amt" prefWidth="100"/>
                        <TableColumn fx:id="colDetails" text="Details" prefWidth="150"/>
                    </columns>
                </TableView>
                <HBox spacing="20" alignment="CENTER_RIGHT" maxWidth="Infinity">
                    <Label text="Total: " styleClass="total-label-text"/>
                    <Label fx:id="lblTotal" text="₹0.00" styleClass="total-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnEditService" text="Edit Selected Service" styleClass="edit-button"/>
                    <Button fx:id="btnDeleteService" text="Delete Selected Service" styleClass="clear-button"/>
                    <Button fx:id="btnPrintInvoice" text="Print Invoice" onAction="#handlePrintInvoice" styleClass="print-button"/>
                </HBox>
            </VBox>
        </VBox>
    </center>

    <right>
        <VBox spacing="20" minWidth="300" prefWidth="350" maxWidth="Infinity">
            <BorderPane.margin>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </BorderPane.margin>

            <VBox spacing="15" styleClass="card" VBox.vgrow="ALWAYS" maxWidth="Infinity" maxHeight="Infinity">
                <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
                <Label text="Service Entry" styleClass="section-title"/>
                <GridPane hgap="10" vgap="10">
                    <Label text="Main Service:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtServiceName" editable="false" GridPane.rowIndex="0" GridPane.columnIndex="1"
                               maxWidth="Infinity" GridPane.hgrow="ALWAYS"/>

                    <Label text="Category Type:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="comboServiceType" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1"
                              GridPane.hgrow="ALWAYS"/>
                </GridPane>

                <VBox spacing="5" styleClass="sub-card" HBox.hgrow="ALWAYS" maxWidth="Infinity" maxHeight="Infinity">
                    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                    <Label text="Add Item Details" styleClass="subsection-title"/>
                    <GridPane hgap="10" vgap="5">
                        <Label text="Item Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <ComboBox fx:id="comboLineItemName" editable="true"  GridPane.rowIndex="0" GridPane.columnIndex="1"
                                   maxWidth="Infinity" GridPane.hgrow="ALWAYS"/>

                        <Label text="Qty:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtLineItemQuantity" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="70"
                                   maxWidth="Infinity" GridPane.hgrow="ALWAYS"/>

                        <Label text="Unit Price:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtLineItemUnitPrice" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="70"
                                   maxWidth="Infinity" GridPane.hgrow="ALWAYS"/>
                    </GridPane>
                    <Button text="Add Item to Service" onAction="#handleAddLineItem" styleClass="add-item-button"
                            maxWidth="Infinity"/>
                </VBox>

                <VBox spacing="5" styleClass="sub-card" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" maxWidth="Infinity" maxHeight="Infinity">
                    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                    <Label text="Items for Current Service" styleClass="subsection-title"/>
                    <TableView fx:id="tableLineItems" VBox.vgrow="ALWAYS" maxWidth="Infinity" maxHeight="Infinity">
                        <columns>
                            <TableColumn fx:id="colLineItemName" text="Item" prefWidth="120"/>
                            <TableColumn fx:id="colLineItemQuantity" text="Qty" prefWidth="50"/>
                            <TableColumn fx:id="colLineItemUnitPrice" text="Unit Price" prefWidth="80"/>
                            <TableColumn fx:id="colLineItemTotal" text="Total" prefWidth="80"/>
                        </columns>
                    </TableView>
                    <HBox alignment="CENTER_RIGHT" spacing="10" maxWidth="Infinity">
                        <Label text="SubTotal:" styleClass="info-label"/>
                        <Label fx:id="lblServiceSubTotal" text="₹0.00" styleClass="info-text-field"
                               HBox.hgrow="ALWAYS"/>
                        <Button text="ClearItems" onAction="#handleClearLineItems" styleClass="clear-button"/>
                    </HBox>
                </VBox>

                <Button fx:id="btnAddService" text="Add Service to Bill" onAction="#handleAddService" styleClass="add-service-button"
                        maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </right>
</BorderPane>